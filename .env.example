# MemoryMeet Environment Configuration Example
# Copy this file to .env and configure your secrets

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./memorymeet.db

# LLM Provider Configuration (Phase 2)
# Supported: gemini, openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Hindsight Long-Term Memory Service Configuration (Phase 2)
# Hindsight Cloud or Self-Hosted Hindsight endpoint
HINDSIGHT_API_KEY=
HINDSIGHT_ENDPOINT=http://localhost:8888
HINDSIGHT_BANK_ID=memorymeet_agent

# Speech-to-Text Configuration (Phase 2)
# Options: gemini_multimodal, openai_whisper
STT_PROVIDER=gemini_multimodal
